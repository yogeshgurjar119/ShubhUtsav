# Copy to .env and fill in. Never commit .env.

# Required for AI ideas and the chat assistant (https://build.nvidia.com).
# Without it the app still works using the built-in idea bank.
NVIDIA_API_KEY=

# Card art (image model on the same NVIDIA account unless you set a separate key)
NVIDIA_IMAGE_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b,black-forest-labs/flux.1-dev

# Explore panel (both optional; each feature switches off cleanly without its key)
# Festivals and holidays: https://calendarific.com
CALENDRIFIC = 
# Live events: https://developer.ticketmaster.com
TICKMASTER_KEY = 

TICKMASTER_SECRET = 

# Optional overrides
# One model, or several separated by commas (tried in order if one is retired)
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_MS=20000

# Public holiday and festival calendar (iCalendar). Leave empty to turn it off.
# HOLIDAY_FEED_URL=

PORT=3000
# Timezone used to decide what "today" is for countdowns
APP_TIMEZONE=Asia/Kolkata
# Number of reverse proxies in front of the app (1 on Render/Heroku, 0 locally)
TRUST_PROXY=0


